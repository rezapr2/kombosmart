        {
            "key": "field_sw_product_condition_notes",
            "label": "توضیحات وضعیت کالا",
            "name": "product_condition_notes",
            "aria-label": "",
            "type": "textarea",
            "instructions": "فقط برای کالای استوک. وضعیت دقیق قطعات را هر مورد در یک خط بنویسید (صفحه نمایش، کیبورد، سلامت SSD، وضعیت باتری، بدنه و ...). در صفحه محصول زیر هشدار استوک نمایش داده می‌شود.",
            "required": 0,
            "conditional_logic": [
                [
                    {
                        "field": "field_sw_product_condition",
                        "operator": "==",
                        "value": "used"
                    }
                ]
            ],
            "wrapper": {
                "width": "",
                "class": "",
                "id": ""
            },
            "default_value": "",
            "maxlength": "",
            "allow_in_bindings": 0,
            "rows": 6,
            "placeholder": "صفحه نمایش: بدون خط و خش، بدون پیکسل سوخته\nکیبورد: سالم، بدون ساییدگی\nسلامت SSD: ۹۶٪\nوضعیت باتری: ۸۵٪ ظرفیت اولیه\nبدنه: خط و خش جزئی روی درب",
            "new_lines": ""
        },
        {
            "key": "field_sw_product_condition_images",
            "label": "تصاویر وضعیت کالا",
            "name": "product_condition_images",
            "aria-label": "",
            "type": "repeater",
            "instructions": "فقط برای کالای استوک. عکس واقعی همین دستگاه (نه عکس رسمی سازنده): درب، صفحه نمایش روشن، کیبورد، زیر دستگاه، پورت‌ها و هر خط و خش یا ایراد ظاهری. در صفحه محصول زیر وضعیت کالا نمایش داده می‌شود و با کلیک بزرگ می‌شود.",
